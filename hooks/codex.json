{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli/entry.js\" hook --agent codex",
            "timeout": 10,
            "statusMessage": "Canary: checking command"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "canary",
            "type": "command",
            "command": "node \"${extensionPath}${/}dist${/}hook${/}gemini-cli.mjs\"",
            "timeout": 10000,
            "description": "Blocks irreversible shell commands"
          }
        ]
      }
    ]
  }
}
